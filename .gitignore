.env.*
!.env.example
# Gmail / OAuth credentials and tokens
client_secret*.json
credentials*.json
*token*.json
# Browser sessions (Playwright storage state, auth captures)
playwright/.auth/
.auth/
storage_state*.json
*.storage-state.json
